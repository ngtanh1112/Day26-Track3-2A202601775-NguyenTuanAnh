{
  "$schema": "https://json.schemastore.org/mcp-server-config.json",
  "mcpServers": {
    "ops-sentinel-stdio": {
      "command": "python",
      "args": [
        "d:/AIVIN/Day26-Track3-2A202601775-NguyenTuanAnh/05-custom-mcp-server/server.py",
        "--transport",
        "stdio"
